# ---------------------------------------------------------------------------
# Template for config/dev.env and config/prod.env.
# Copy this file to config/dev.env and fill in real values.
# dev.env / prod.env are gitignored — this template is the only committed copy.
#
# Every variable below is required at boot unless marked optional.
# See src/config/env.validation.ts for the schema.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=veltrixair_web
# Optional. Auto-enabled for *.rds.amazonaws.com hosts; set explicitly otherwise.
DB_SSL=false

# --- CORS: comma-separated allowlist of browser origins ---
# One backend serves three brands, so this lists every public site AND every
# admin dashboard subdomain. A missing origin looks like a broken form.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (optional) ---
# TTL in milliseconds, limit = requests per TTL per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Privacy / consent ---
PRIVACY_NOTICE_VERSION=privacy-notice-2026-08-01
# HMAC pepper for hashing submitter IPs. Minimum 32 characters — the app refuses
# to boot below that, so this placeholder fails deliberately.
# Generate a distinct value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never rotate it once live: every stored hash becomes unmatchable.
IP_PEPPER=CHANGE_ME

# --- Mail ---
MAIL_FROM=no-reply@veltrixair.com

# --- Anti-spam (optional) ---
# When unset, Turnstile verification is skipped so local dev works without Cloudflare.
# TURNSTILE_SECRET=

# --- File storage (Supabase Storage) ---
# Bucket MUST be private — every read goes through a short-lived signed URL.
# Without these two, the app falls back to local filesystem storage, which is
# for development only (containers are ephemeral; instances don't share files).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=veltrixair-assets
# STORAGE_DRIVER=supabase|local  — inferred from the two values above if unset.
SIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_DIR=storage

# --- Admin authentication ---
# Signing key for staff access tokens. Minimum 32 characters; the app refuses to
# boot below that. Generate a distinct value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it is safe but logs every admin out — all existing tokens stop verifying.
ADMIN_JWT_SECRET=CHANGE_ME
# Access tokens are deliberately short-lived; the refresh token carries the session.
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# --- Malware scanning ---
# No scanner is wired up yet, so uploads are recorded as PENDING. Setting this
# to true blocks downloads of anything not CLEAN — turn it on once a real
# scanner is in place, or nothing will be downloadable.
SCAN_REQUIRED=false
